# Backend
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
REDIS_URL=redis://localhost:6380

# Comma-separated plugin ids to load (folder names under plugins/)
PLUGINS=

# plugins/serpapi-google-maps (backlog: enable with PLUGINS=serpapi-google-maps)
SERPAPI_API_KEY=

# Databases (docker compose up -d)
MONGO_URL=mongodb://localhost:27017/perforvisor
DATABASE_URL=postgres://perforvisor:perforvisor@localhost:5434/perforvisor

# Model servers (docker compose --profile llm up -d). Each role is an OpenAI-compatible vLLM endpoint.
CHAT_BASE_URL=http://localhost:8000/v1
CHAT_MODEL=Qwen/Qwen3-4B-AWQ
# Extraction defaults to the chat model; set these to split it out.
EXTRACT_BASE_URL=
EXTRACT_MODEL=
EMBED_BASE_URL=http://localhost:8001/v1
EMBED_MODEL=google/embeddinggemma-2
EMBED_DIMENSIONS=768
# Only needed if vLLM is started with --api-key
MODEL_API_KEY=
LLM_CONCURRENCY=4
# How many of the most similar reviews the answer step reads
ASK_TOP_K=8

# Share of the GPU each model server reserves (docker compose only)
VLLM_CHAT_GPU_SHARE=0.52
VLLM_EMBED_GPU_SHARE=0.14

# Hugging Face token; needed for gated models
HF_TOKEN=

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/client",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "fastify",
      "entrypoint": "src/index.ts"
    },
    "jobs": {
      "root": "jobs",
      "functions": {
        "app/api/queues/sync/route.ts": {
          "experimentalTriggers": [
            {
              "type": "queue/v2beta",
              "topic": "perforvisor-sync",
              "maxDeliveries": 10
            }
          ]
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/v1/cron/resync",
      "schedule": "0 3 * * *"
    }
  ]
}

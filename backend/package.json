  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "eval:retrieval": "tsx --env-file-if-exists=../.env scripts/eval-retrieval.ts",
    "try:serpapi": "tsx --env-file-if-exists=../.env scripts/try-serpapi.ts",
    "start": "node dist/index.js",
    "bundle": "tsup"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/sensible": "^6.0.7",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.5.0",
    "@langchain/openai": "^1.6.2",
    "@perforvisor/core": "workspace:*",
    "@perforvisor/plugin-serpapi-google-maps": "workspace:*",
    "@vercel/queue": "^0.8.0",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "mongodb": "^7.7.0",
    "openai": "7.32.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"

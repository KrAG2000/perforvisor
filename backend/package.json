{
  "name": "@perforvisor/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=../.env src/api.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../.env src/worker.ts",
    "dev": "concurrently -n api,worker -c blue,magenta \"pnpm dev:api\" \"pnpm dev:worker\"",
    "build": "tsup",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json",
    "eval:retrieval": "tsx --env-file-if-exists=../.env scripts/eval-retrieval.ts",
    "try:serpapi": "tsx --env-file-if-exists=../.env scripts/try-serpapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/sensible": "^6.0.7",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.5.0",
    "@langchain/openai": "^1.6.2",
    "@perforvisor/core": "workspace:*",
    "@perforvisor/plugin-serpapi-google-maps": "workspace:*",
    "bullmq": "^6.3.14",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
